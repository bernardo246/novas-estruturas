+}
+
+.contact-card:hover {
+  border-color: rgba(245, 183, 0, 0.4);
+  box-shadow: 0 20px 60px rgba(20, 33, 61, 0.35);
+}
 
 /* Footer */
 .footer { background: var(--bg); border-top: 1px solid var(--border-soft); }
